# --- app ---
NODE_ENV=development
APP_URL=http://localhost:3000
SESSION_SECRET=change-me-32-bytes-minimum

# --- database (Postgres 16 + pgvector) ---
# Set this and auth switches on automatically. Leave empty for preview mode.
DATABASE_URL=postgres://rabbitgun:rabbitgun@localhost:5432/rabbitgun
# Force SSL when your Postgres needs it (Railway public URL does):
PGSSL=

# --- the three humans (seed: node db/seed-users.mjs) ---
# Set individually, or RABBITGUN_INITIAL_PASSWORD for all three.
NAV_PASSWORD=
DANTE_PASSWORD=
TOM_PASSWORD=
RABBITGUN_INITIAL_PASSWORD=

# --- files (Backblaze B2 in prod, ./data/files in dev) ---
STORAGE_DRIVER=local
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=
B2_ENDPOINT=

# --- models: NONE hosted. Rabbitgun is the in-home AI. ---
# Embeddings and any generation run locally on the home box (MiniLM is wired;
# the generation model slots in beside it). No Anthropic key, no hosted LLM,
# no free-tier model — business data never leaves the hardware we own.
# (The separate Monarch Preflight product backend may use its own paid,
# zero-retention models — that service is not this one.)

# --- Jarvis (the in-home brain) ---
JARVIS_URL=http://localhost:4400
JARVIS_KEY=
# Token Jarvis must present when calling /api/jarvis/*
RABBITGUN_FEED_TOKEN=

# --- connectors (read-only to start) ---
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
STRIPE_SECRET_KEY=
GA4_PROPERTY_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
AMAZON_SELLER_REFRESH_TOKEN=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
